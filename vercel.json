{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/flex-sync",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/forgot-password/", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/reset-password/", "destination": "/index.html" }
  ],
  "functions": {
    "api/flex-sync.js": {
      "maxDuration": 60
    },
    "api/option-marks.js": {
      "maxDuration": 30
    }
  }
}

{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/flex-cron",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/flex-sync.js": {
      "maxDuration": 60
    },
    "api/flex-cron.js": {
      "maxDuration": 60
    },
    "api/option-marks.js": {
      "maxDuration": 30
    }
  }
}
